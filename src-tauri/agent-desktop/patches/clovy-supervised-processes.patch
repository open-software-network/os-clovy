+
+fn merge_errors(mut primary: AdapterError, secondary: AdapterError, stage: &str) -> AdapterError {
+    use agent_desktop_core::{DeliverySemantics, RetryDisposition};
+    let both_retryable = definitively_unsent(&primary) && definitively_unsent(&secondary);
+    let primary_details = primary.details.take();
+    let mut details = match primary_details {
+        Some(serde_json::Value::Object(object)) => object,
+        Some(value) => serde_json::Map::from_iter([("original_details".into(), value)]),
+        None => serde_json::Map::new(),
+    };
+    let key = format!("{stage}_error");
+    let secondary_evidence = serde_json::json!({
+        "code": secondary.code.as_str(),
+        "message": secondary.message,
+        "details": secondary.details,
+        "suggestion": secondary.suggestion,
+        "platform_detail": secondary.platform_detail,
+        "disposition": secondary.disposition,
+    });
+    let evidence = match details.remove(&key) {
+        Some(previous) => {
+            serde_json::json!({"previous": previous, "additional": secondary_evidence})
         }
+        None => secondary_evidence,
+    };
+    details.insert(key, evidence);
+    if let Some(previous) =
+        details.insert("retryable".into(), serde_json::Value::Bool(both_retryable))
+    {
+        details.entry("original_retryable").or_insert(previous);
     }
+    let disposition = if primary.disposition.retry() == RetryDisposition::Unsafe
+        || secondary.disposition.retry() == RetryDisposition::Unsafe
+    {
+        DeliverySemantics::uncertain()
+    } else if primary.disposition == DeliverySemantics::not_delivered()
+        && secondary.disposition == DeliverySemantics::not_delivered()
+    {
+        DeliverySemantics::not_delivered()
+    } else {
+        DeliverySemantics::unknown()
+    };
+    primary
+        .with_details(serde_json::Value::Object(details))
+        .with_disposition(disposition)
 }

