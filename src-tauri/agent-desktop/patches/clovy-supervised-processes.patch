+pub(crate) fn global_focused_element(deadline: Deadline) -> Result<AXElement, AdapterError> {
+    let system = AXElement::from_raw(unsafe { accessibility_sys::AXUIElementCreateSystemWide() });
+    let mut app = crate::tree::properties::attributes::copy_element_attr_result(
+        &system,
+        "AXFocusedApplication",
+        deadline,
+    )
+    .map_err(|_| AdapterError::stale_ref_because("Foreground application is unavailable"))?
+    .ok_or_else(|| AdapterError::stale_ref_because("Foreground application is unavailable"))?;
+    let pid = crate::tree::properties::ax_ipc::pid(&app, deadline)
+        .map_err(|_| AdapterError::stale_ref_because("Foreground process is unavailable"))?;
+    let instance = crate::system::private_browser_guard::require_pid(pid, None)?;
+    let instant = crate::tree::locator_deadline::from_operation(deadline)?;
+    app.bind_process(pid, &instance, instant)?;
+    crate::tree::surface_read::element(&app, "AXFocusedUIElement", instant)?
+        .ok_or_else(|| AdapterError::stale_ref_because("Keyboard focus is unavailable"))
+}
