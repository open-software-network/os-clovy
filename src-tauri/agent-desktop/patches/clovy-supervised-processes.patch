+pub(crate) fn revalidate_native_geometry(
+    window_number: i64,
+    expected_pid: i32,
+    expected: agent_desktop_core::Rect,
+    deadline: Instant,
+) -> Result<(), AdapterError> {
+    let expected = expected
+        .validate()
+        .map_err(|_| AdapterError::stale_ref_because("Original window geometry is invalid"))?;
+    if expected.width <= 0.0 || expected.height <= 0.0 {
+        return Err(AdapterError::stale_ref_because(
+            "Original window geometry is unavailable",
+        ));
+    }
+    let (pid, dictionary) = native_window_evidence(window_number, deadline)?;
+    let bounds = super::cg_window::rect_field(&dictionary, "kCGWindowBounds");
+    if pid != expected_pid || bounds != Some(expected) {
+        return Err(AdapterError::stale_ref_because(
+            "Original window geometry changed",
+        ));
+    }
+    super::cg_window::ensure_before_deadline(deadline)
+}
+
