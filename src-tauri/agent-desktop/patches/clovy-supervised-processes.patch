@@ -22,6 +22,67 @@ pub(crate) struct PointResolveAttempt<'a> {
     pub args: crate::commands::point_resolve::PointResolveArgs<'a>,
     pub stability: Option<Option<u64>>,
     pub allow_scroll: bool,
+    pub effects: &'a PointEffects,
+}
+
+#[derive(Default)]
+pub(crate) struct PointEffects {
+    focus: std::cell::Cell<u8>,
+    scroll: std::cell::Cell<u8>,
+}
+
+impl PointEffects {
+    fn record_scroll(&self, result: Result<(), crate::AdapterError>) -> Result<(), AppError> {
+        let state = &self.scroll;
+        match result {
+            Ok(()) => {
+                state.set(2);
+                Ok(())
+            }
+            Err(error) => {
+                if error.disposition.retry() != crate::RetryDisposition::Safe {
+                    state.set(state.get().max(1));
+                }
+                Err(error.into())
+            }
+        }
+    }
+
+    fn has_effect(&self) -> bool {
+        self.focus.get() != 0 || self.scroll.get() != 0
+    }
+
+    pub(crate) fn annotate(&self, error: AppError) -> AppError {
+        if !self.has_effect() {
+            return error;
+        }
+        let mut error = crate::ref_action::into_adapter_error(error);
+        let mut details = match error.details.take() {
+            Some(Value::Object(object)) => object,
+            Some(value) => serde_json::Map::from_iter([("original_details".into(), value)]),
+            None => serde_json::Map::new(),
+        };
+        details
+            .entry("native_disposition")
+            .or_insert_with(|| json!(error.disposition));
+        let current = json!({
+            "focus": {"attempted":self.focus.get()!=0,"confirmed":self.focus.get()==2},
+            "scroll": {"attempted":self.scroll.get()!=0,"confirmed":self.scroll.get()==2},
+        });
+        let combined = match details.remove("preparatory_effects") {
