+pub(crate) fn global_focus_is_original(
+    expected: &AXElement,
+    system: &AXElement,
+    authority: &crate::tree::ax_element::NativeEffectAuthority,
+) -> bool {
+    use core_foundation::{base::TCFType, string::CFString};
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(2);
+    if authority.revalidate(expected, deadline).is_err() {
+        return false;
+    }
+    let attribute = CFString::new("AXFocusedUIElement");
+    let mut value = std::ptr::null();
+    let error = unsafe {
+        accessibility_sys::AXUIElementCopyAttributeValue(
+            system.raw(),
+            attribute.as_concrete_TypeRef(),
+            &mut value,
+        )
+    };
+    if error != accessibility_sys::kAXErrorSuccess {
+        if !value.is_null() {
+            unsafe { core_foundation::base::CFRelease(value) };
+        }
+        return false;
+    }
+    crate::tree::properties::ax_value::created_ax_element(value)
+        .is_some_and(|current| crate::tree::same_element(expected, &current))
+        && authority.revalidate(expected, deadline).is_ok()
+}
