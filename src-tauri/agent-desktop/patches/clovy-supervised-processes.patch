@@ -0,0 +1,1228 @@
+use crate::tree::AXElement;
+use agent_desktop_core::{AdapterError, Deadline, MouseEvent, MouseEventKind, Point};
+use core_graphics::event::{
+    CGEvent, CGEventFlags, CGEventTapLocation, CGEventType, EventField, ScrollEventUnit,
+};
+use core_graphics::geometry::CGPoint;
+
+#[derive(Clone, Copy)]
+pub(crate) enum Target<'a> {
+    Window {
+        window: &'a AXElement,
+        bounds: agent_desktop_core::Rect,
+    },
+    ReferenceWindow(&'a AXElement),
+    Element {
+        window: &'a AXElement,
+        element: &'a AXElement,
+    },
+}
+
+pub(crate) enum Destination<'a> {
+    Window,
+    Element(&'a AXElement),
+}
+
+impl Target<'_> {
+    fn window(&self) -> &AXElement {
+        match self {
+            Self::Window { window, .. }
+            | Self::ReferenceWindow(window)
+            | Self::Element { window, .. } => window,
+        }
+    }
+
+    fn window_scope(&self) -> Self {
+        match self {
+            Self::Window { window, bounds } => Self::Window {
+                window,
+                bounds: *bounds,
+            },
+            Self::ReferenceWindow(window) | Self::Element { window, .. } => {
+                Self::ReferenceWindow(window)
+            }
+        }
+    }
+}
+
+struct Receiver<'a> {
+    target: Target<'a>,
+    window_number: i64,
+    screen_height: f64,
+    class: *mut std::ffi::c_void,
+    selector: *mut std::ffi::c_void,
+    app: AXElement,
+    system: AXElement,
+    pointer_source: core_graphics::event_source::CGEventSource,
+    main_attribute: core_foundation::string::CFString,
+    front_attribute: core_foundation::string::CFString,
+    focus_attribute: core_foundation::string::CFString,
+}
+
+#[derive(Clone, Copy)]
+enum PointerState<'a> {
+    FreeMove,
+    FreeAtPoint,
+    Held {
+        down: &'a Permit,
+        button: u32,
+        source: i32,
+        cursor: &'a Point,
+    },
+}
+
+impl<'a> Receiver<'a> {
+    fn new(target: Target<'a>, id: &str, deadline: Deadline) -> Result<Self, AdapterError> {
+        let window_number = crate::system::window::window_resolve::parse_window_number(id)
+            .ok_or_else(|| {
+                AdapterError::stale_ref_because("Original pointer window is unavailable")
+            })?;
+        unsafe extern "C" {
+            fn objc_getClass(name: *const std::ffi::c_char) -> *mut std::ffi::c_void;
+            fn sel_registerName(name: *const std::ffi::c_char) -> *mut std::ffi::c_void;
+        }
+        let class = unsafe { objc_getClass(c"NSWindow".as_ptr()) };
+        let selector = unsafe {
+            sel_registerName(c"windowNumberAtPoint:belowWindowWithWindowNumber:".as_ptr())
+        };
+        let screen_height = core_graphics::display::CGDisplay::main()
+            .bounds()
+            .size
+            .height;
+        if class.is_null()
+            || selector.is_null()
+            || !screen_height.is_finite()
+            || screen_height <= 0.0
+        {
+            return Err(AdapterError::stale_ref_because(
+                "Pointer receiver is unavailable",
+            ));
+        }
+        let instant = crate::tree::locator_deadline::from_operation(deadline)?;
+        let window = target.window();
+        let pid = crate::system::process::process_identity::to_pid_t(window.root_identity()?.pid)?;
+        let mut app = crate::tree::element_for_pid(pid);
+        app.bind_child(window, instant)?;
+        let system =
+            AXElement::from_raw(unsafe { accessibility_sys::AXUIElementCreateSystemWide() });
+        let pointer_source = crate::input::mouse::event_source()?;
+        Ok(Self {
+            target,
+            window_number,
+            screen_height,
+            class,
+            selector,
+            app,
+            system,
+            pointer_source,
+            main_attribute: core_foundation::string::CFString::new("AXMain"),
+            front_attribute: core_foundation::string::CFString::new("AXFrontmost"),
+            focus_attribute: core_foundation::string::CFString::new("AXFocusedUIElement"),
+        })
+    }
+
+    fn native_window_number(&self, point: &Point) -> Option<i64> {
+        unsafe extern "C" {
+            fn objc_msgSend(
+                receiver: *mut std::ffi::c_void,
+                selector: *mut std::ffi::c_void,
+                ...
+            ) -> *mut std::ffi::c_void;
+        }
+        let call: unsafe extern "C" fn(
+            *mut std::ffi::c_void,
+            *mut std::ffi::c_void,
+            CGPoint,
+            isize,
+        ) -> isize = unsafe { std::mem::transmute(objc_msgSend as *const ()) };
+        let appkit = CGPoint::new(point.x, self.screen_height - point.y);
+        let number = unsafe { call(self.class, self.selector, appkit, 0) };
+        (number > 0).then_some(number as i64)
+    }
+
+    fn native_window_at(&self, point: &Point) -> bool {
+        self.native_window_number(point) == Some(self.window_number)
+    }
+
+    fn revalidate_geometry(&self, deadline: std::time::Instant) -> Result<(), AdapterError> {
+        if let Target::Window { window, bounds } = self.target {
+            let pid =
+                crate::system::process::process_identity::to_pid_t(window.root_identity()?.pid)?;
+            crate::system::window::cg_window_exact::revalidate_native_geometry(
+                self.window_number,
+                pid,
+                bounds,
+                deadline,
+            )?;
+        }
+        Ok(())
+    }
+
+    fn revalidate_cleanup_owner(&self, deadline: std::time::Instant) -> Result<(), AdapterError> {
+        let pid = crate::system::process::process_identity::to_pid_t(
+            self.target.window().root_identity()?.pid,
+        )?;
+        crate::system::window::cg_window_exact::revalidate_native_owner(
+            self.window_number,
+            pid,
+            deadline,
+        )
+    }
+
+    fn qualify(
