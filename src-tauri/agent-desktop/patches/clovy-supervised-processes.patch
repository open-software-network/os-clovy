@@ -0,0 +1,32 @@
+use agent_desktop_core::AdapterError;
+use std::{
+    process::{Child, Command},
+    time::Instant,
+};
+
+pub(crate) fn classify_capture_failure(error: AdapterError, attempted: bool) -> AdapterError {
+    if attempted {
+        error.with_disposition(agent_desktop_core::DeliverySemantics::uncertain())
+    } else {
+        error.with_disposition(agent_desktop_core::DeliverySemantics::not_delivered())
+    }
+}
+
+pub(crate) fn spawn_checked(
+    command: &mut Command,
+    label: &str,
+    deadline: Instant,
+    before_spawn: impl FnOnce() -> Result<(), AdapterError>,
+    on_attempt: impl FnOnce(),
+) -> Result<Child, AdapterError> {
+    before_spawn()?;
+    if Instant::now() >= deadline {
+        return Err(AdapterError::timeout(format!(
+            "{label} has no subprocess cleanup budget"
+        )));
+    }
+    on_attempt();
+    command
+        .spawn()
+        .map_err(|error| AdapterError::internal(format!("{label}: {error}")))
+}
