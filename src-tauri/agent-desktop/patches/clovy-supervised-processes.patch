+pub(crate) fn keyboard_window_authority(
+    expected: &AXElement,
+    window: &AXElement,
+    require_foreground: bool,
+    deadline: Deadline,
+) -> Result<
+    (
+        crate::tree::ax_element::NativeEffectAuthority,
+        crate::tree::ax_element::NativeEffectAuthority,
+    ),
+    AdapterError,
+> {
+    use core_foundation::{base::TCFType, string::CFString};
+    let instant = crate::tree::locator_deadline::from_operation(deadline)?;
+    let window_authority = window.effect_authority(instant)?;
+    let pid = crate::system::process::process_identity::to_pid_t(expected.root_identity()?.pid)?;
+    let mut app = crate::tree::element_for_pid(pid);
+    app.bind_child(expected, instant)?;
+    crate::tree::properties::ax_ipc::prepare(expected, instant)?;
+    crate::tree::properties::ax_ipc::prepare(&app, instant)?;
+    let window_attribute = CFString::new("AXWindow");
+    let focus_attribute = CFString::new("AXFocusedUIElement");
+    let focused_authority = keyboard_effect_authority(expected, require_foreground, deadline)?;
+    let read = |element: &AXElement, attribute: &CFString| -> Result<AXElement, AdapterError> {
+        let mut value = std::ptr::null();
+        let error = unsafe {
+            accessibility_sys::AXUIElementCopyAttributeValue(
+                element.raw(),
+                attribute.as_concrete_TypeRef(),
+                &mut value,
+            )
+        };
+        if error != accessibility_sys::kAXErrorSuccess {
+            if !value.is_null() {
+                unsafe { core_foundation::base::CFRelease(value) };
+            }
+            return Err(AdapterError::stale_ref_because(
+                "Original keyboard window could not be revalidated",
+            ));
+        }
+        crate::tree::properties::ax_value::created_ax_element(value).ok_or_else(|| {
+            AdapterError::stale_ref_because("Original keyboard window is unavailable")
+        })
+    };
+    if !crate::tree::same_element(&read(expected, &window_attribute)?, window) {
+        return Err(AdapterError::stale_ref_because("Keyboard window changed"));
+    }
+    if !crate::tree::same_element(&read(&app, &focus_attribute)?, expected) {
+        return Err(AdapterError::stale_ref_because("Keyboard focus changed"));
+    }
+    window_authority.revalidate(window, instant)?;
+    focused_authority.revalidate(expected, instant)?;
+    if !crate::tree::same_element(&read(&app, &focus_attribute)?, expected) {
+        return Err(AdapterError::stale_ref_because("Keyboard focus changed"));
+    }
+    deadline.ensure_remaining()?;
+    Ok((focused_authority, window_authority))
+}
