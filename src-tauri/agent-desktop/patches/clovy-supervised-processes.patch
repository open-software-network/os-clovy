+fn native_window_evidence(
+    window_number: i64,
+    deadline: Instant,
+) -> Result<(i32, WindowDictionary), AdapterError> {
+    super::cg_window::ensure_before_deadline(deadline)?;
+    let dictionaries = exact_window_dictionaries(window_number)?;
+    let [dictionary] = dictionaries.as_slice() else {
+        return Err(AdapterError::stale_ref_because(
+            "Pointer window is unavailable or ambiguous",
+        ));
+    };
+    let number = super::cg_window::required_int_field(dictionary, "kCGWindowNumber")?;
+    let owner = super::cg_window::required_int_field(dictionary, "kCGWindowOwnerPID")?;
+    if number != window_number {
+        return Err(AdapterError::stale_ref_because("Pointer window changed"));
+    }
+    let pid = i32::try_from(owner)
+        .ok()
+        .filter(|pid| *pid > 0)
+        .ok_or_else(|| AdapterError::stale_ref_because("Pointer window owner is unavailable"))?;
+    super::cg_window::ensure_before_deadline(deadline)?;
+    Ok((pid, dictionary.clone()))
+}
