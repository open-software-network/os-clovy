+    assert_eq!(recorded.len(), 2);
+    assert_eq!((recorded[0].vk, recorded[0].flags), (VK_CONTROL, 0));
+    assert_eq!(
+        (recorded[1].vk, recorded[1].flags),
+        (VK_CONTROL, KEYEVENTF_KEYUP)
+    );
