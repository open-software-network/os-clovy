+pub(crate) fn keyboard_effect_authority(
+    expected: &AXElement,
+    require_foreground: bool,
+    deadline: Deadline,
+) -> Result<crate::tree::ax_element::NativeEffectAuthority, AdapterError> {
+    use core_foundation::{base::TCFType, string::CFString};
+
+    let instant = crate::tree::locator_deadline::from_operation(deadline)?;
+    let identity = expected.root_identity()?;
+    let pid = crate::system::process::process_identity::to_pid_t(identity.pid)?;
+    let mut app = crate::tree::element_for_pid(pid);
+    app.bind_child(expected, instant)?;
