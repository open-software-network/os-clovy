+            if !current.is_null() {
+                unsafe { core_foundation::base::CFRelease(current.cast()) };
+            }
+            return Err(AdapterError::stale_ref_because("Pointer receiver changed"));
+        }
+        let current = AXElement::from_raw(current);
+        if !crate::tree::same_element(&hit, &current) {
+            return Err(AdapterError::stale_ref_because(
+                "Pointer receiver or capture changed",
+            ));
+        }
+        window_authority.revalidate(window, instant)?;
+        hit_authority.revalidate(&hit, instant)?;
+        if let Original::Element { element, authority } = &original {
+            authority.revalidate(element, instant)?;
+        }
+        if let Some(previous) = &previous {
+            let location = previous.location;
+            let mut current_hit = std::ptr::null_mut();
+            let error = unsafe {
+                accessibility_sys::AXUIElementCopyElementAtPosition(
+                    system.raw(),
+                    location.x as f32,
+                    location.y as f32,
+                    &mut current_hit,
+                )
+            };
+            if error != accessibility_sys::kAXErrorSuccess || current_hit.is_null() {
+                if !current_hit.is_null() {
+                    unsafe { core_foundation::base::CFRelease(current_hit.cast()) };
+                }
+                return Err(AdapterError::stale_ref_because(
+                    "Previous pointer receiver changed",
+                ));
+            }
+            let current_hit = AXElement::from_raw(current_hit);
+            if !crate::tree::same_element(&previous.hit, &current_hit) {
+                return Err(AdapterError::stale_ref_because(
+                    "Previous pointer receiver changed",
+                ));
+            }
+            previous.authority.revalidate()?;
+            previous.window_authority.revalidate()?;
+            crate::system::window::cg_window_exact::revalidate_native_owner(
+                previous.window_number,
+                previous.window_pid,
+                instant,
+            )?;
+        }
+        let expected_location = previous
+            .as_ref()
+            .map(|previous| previous.location)
+            .unwrap_or_else(|| {
+                let cursor = expected_cursor.unwrap_or(point);
+                CGPoint::new(cursor.x, cursor.y)
+            });
+        if !native_boolean(window, &main_attribute)
+            || !native_boolean(&app, &front_attribute)
+            || !native_boolean(window, &main_attribute)
+        {
+            return Err(AdapterError::stale_ref_because(
+                "Pointer receiver or capture changed",
+            ));
+        }
+        let mut final_hit = std::ptr::null_mut();
+        let error = unsafe {
+            accessibility_sys::AXUIElementCopyElementAtPosition(
+                system.raw(),
+                point.x as f32,
+                point.y as f32,
+                &mut final_hit,
+            )
+        };
+        if error != accessibility_sys::kAXErrorSuccess || final_hit.is_null() {
+            if !final_hit.is_null() {
+                unsafe { core_foundation::base::CFRelease(final_hit.cast()) };
+            }
+            return Err(AdapterError::stale_ref_because("Pointer receiver changed"));
+        }
+        let final_hit = AXElement::from_raw(final_hit);
+        if !crate::tree::same_element(&hit, &final_hit) {
+            return Err(AdapterError::stale_ref_because("Pointer receiver changed"));
+        }
+        self.revalidate_geometry(instant)?;
+        window_authority.revalidate(window, instant)?;
+        hit_authority.revalidate(&hit, instant)?;
+        if let PointerState::Held { down, .. } = &state {
+            down.window.revalidate(window, instant)?;
+            down.hit.revalidate(&down.element, instant)?;
+            if let Original::Element { element, authority } = &down.original {
+                authority.revalidate(element, instant)?;
+            }
+        }
+        if let Original::Element { element, authority } = &original {
+            authority.revalidate(element, instant)?;
+        }
+        if let Some(previous) = &previous {
+            previous.authority.revalidate()?;
+            previous.window_authority.revalidate()?;
+            crate::system::window::cg_window_exact::revalidate_native_owner(
+                previous.window_number,
+                previous.window_pid,
+                instant,
+            )?;
+        }
+        if let Some((focused, authority)) = &move_focus {
+            authority.revalidate(focused, instant)?;
+            let mut value = std::ptr::null();
+            use core_foundation::base::TCFType;
+            let error = unsafe {
+                accessibility_sys::AXUIElementCopyAttributeValue(
+                    app.raw(),
+                    focus_attribute.as_concrete_TypeRef(),
+                    &mut value,
+                )
+            };
+            if error != accessibility_sys::kAXErrorSuccess || value.is_null() {
+                if !value.is_null() {
+                    unsafe { core_foundation::base::CFRelease(value) };
+                }
+                return Err(AdapterError::stale_ref_because(
+                    "Pointer move focus changed",
+                ));
+            }
+            let current =
+                crate::tree::properties::ax_value::created_ax_element(value).ok_or_else(|| {
+                    AdapterError::stale_ref_because("Pointer move focus is unavailable")
+                })?;
+            if !crate::tree::same_element(focused, &current) {
+                return Err(AdapterError::stale_ref_because(
+                    "Pointer move focus changed",
+                ));
+            }
+            authority.revalidate(focused, instant)?;
+        }
+        let latest = CGEvent::new(pointer_source.clone())
+            .map_err(|()| AdapterError::internal("Pointer position unavailable"))?
+            .location();
+        if (latest.x - expected_location.x).abs() > 0.5
+            || (latest.y - expected_location.y).abs() > 0.5
+            || previous.as_ref().is_some_and(|previous| {
+                self.native_window_number(&Point {
+                    x: previous.location.x,
+                    y: previous.location.y,
+                }) != Some(previous.window_number)
+            })
+            || !self.native_window_at(point)
+            || match state {
+                PointerState::FreeMove | PointerState::FreeAtPoint => any_button_down(),
+                PointerState::Held { button, source, .. } => {
+                    !button_down(source, button)
+                        || button_down(1, button)
+                        || (0..32).any(|other| other != button && button_down(0, other))
+                }
+            }
+        {
+            return Err(AdapterError::stale_ref_because(
+                "Pointer position or capture changed",
+            ));
+        }
+        // Geometry is read again at the final native boundary, after the
+        // provider reads above which may have blocked.
+        self.revalidate_geometry(instant)?;
+        let latest = CGEvent::new(self.pointer_source.clone())
+            .map_err(|()| AdapterError::internal("Pointer position unavailable"))?
+            .location();
+        if (latest.x - expected_location.x).abs() > 0.5
+            || (latest.y - expected_location.y).abs() > 0.5
+            || !self.native_window_at(point)
+            || match state {
+                PointerState::FreeMove | PointerState::FreeAtPoint => any_button_down(),
+                PointerState::Held { button, source, .. } => {
+                    !button_down(source, button)
+                        || button_down(1, button)
+                        || (0..32).any(|other| other != button && button_down(0, other))
+                }
+            }
+        {
+            return Err(AdapterError::stale_ref_because(
+                "Pointer position or capture changed",
+            ));
+        }
+        deadline.ensure_remaining()?;
+        Ok(Permit {
+            window: window_authority,
+            hit: hit_authority,
+            element: hit,
+            original,
+            _previous: previous,
+            _move_focus: move_focus,
+        })
+    }
+}
+
+struct Previous {
+    location: CGPoint,
+    hit: AXElement,
+    authority: crate::system::private_browser_guard::NativeAuthority,
+    window_number: i64,
+    window_pid: i32,
+    window_authority: crate::system::private_browser_guard::NativeAuthority,
+}
+
+fn background_refusal(error: AdapterError) -> AdapterError {
+    if error.code == agent_desktop_core::ErrorCode::ActionFailed
+        && error
+            .details
+            .as_ref()
+            .is_some_and(|details| details["physical_delivery_started"] == false)
+    {
+        AdapterError::not_supported("background physical pointer").with_suggestion(
+            "Bring the target window forward, or choose headed mode before retrying.",
+        )
+    } else {
+        error
+    }
+}
+
+fn native_boolean(element: &AXElement, attribute: &core_foundation::string::CFString) -> bool {
+    use core_foundation::base::TCFType;
+    let mut value = std::ptr::null();
+    let error = unsafe {
+        accessibility_sys::AXUIElementCopyAttributeValue(
+            element.raw(),
+            attribute.as_concrete_TypeRef(),
+            &mut value,
+        )
+    };
+    if value.is_null() {
+        return false;
+    }
+    let valid = error == accessibility_sys::kAXErrorSuccess
+        && unsafe {
+            core_foundation_sys::base::CFGetTypeID(value)
+                == core_foundation_sys::number::CFBooleanGetTypeID()
+                && core_foundation_sys::number::CFBooleanGetValue(value.cast())
+        };
+    unsafe { core_foundation::base::CFRelease(value) };
+    valid
+}
+
+struct Permit {
+    window: std::sync::Arc<crate::tree::ax_element::NativeEffectAuthority>,
+    hit: std::sync::Arc<crate::tree::ax_element::NativeEffectAuthority>,
+    element: AXElement,
+    original: Original,
+    _previous: Option<Previous>,
+    _move_focus: Option<(AXElement, crate::tree::ax_element::NativeEffectAuthority)>,
+}
+
+enum Original {
+    Window,
+    Element {
+        element: AXElement,
+        authority: crate::tree::ax_element::NativeEffectAuthority,
+    },
+}
+
+fn any_button_down() -> bool {
+    unsafe extern "C" {
+        fn CGEventSourceButtonState(state: i32, button: u32) -> bool;
+    }
+    (0..32).any(|button| unsafe { CGEventSourceButtonState(0, button) })
+}
+
+pub(crate) fn send(
+    target: Target<'_>,
+    id: &str,
+    event: MouseEvent,
+    deadline: Deadline,
+) -> Result<(), AdapterError> {
+    use crate::input::mouse::{down_type, event_flags, to_cg_button, up_type};
+    crate::input::mouse::validate_point(&event.point)?;
+    let receiver = Receiver::new(target, id, deadline)?;
+    let scroll_chunks = match &event.kind {
+        MouseEventKind::Down | MouseEventKind::Up => {
+            return Err(AdapterError::not_supported("standalone mouse state"));
+        }
+        MouseEventKind::Click { count } => {
+            agent_desktop_core::validate_mouse_click_count(*count)?;
+            None
+        }
+        MouseEventKind::Wheel { delta_x, delta_y } => {
+            Some(crate::input::mouse::mouse_scroll::scroll_chunks((
+                crate::input::mouse::wheel_lines_to_i32(*delta_y)?,
+                crate::input::mouse::wheel_lines_to_i32(*delta_x)?,
+            ))?)
+        }
+        MouseEventKind::Move => None,
+    };
+    let source = core_graphics::event_source::CGEventSource::new(
+        core_graphics::event_source::CGEventSourceStateID::Private,
+    )
+    .map_err(|()| AdapterError::internal("Private pointer event source is unavailable"))?;
+    let button = to_cg_button(&event.button);
+    let flags: CGEventFlags = event_flags(&event.modifiers);
+    let point = CGPoint::new(event.point.x, event.point.y);
+    let mut delivery = crate::actions::DeliveryTracker::default();
+    let move_event = crate::input::mouse::create_event_with_source(
+        &source,
+        CGEventType::MouseMoved,
+        point,
+        button,
+        flags,
+    )?;
+    let _authority = receiver.qualify(&event.point, deadline, PointerState::FreeMove)?;
+    move_event.post(CGEventTapLocation::HID);
+    delivery.mark_delivered();
+    let after_effect = |error| crate::actions::DeliveryTracker::uncertain(error);
+    if !matches!(event.kind, MouseEventKind::Move) {
+        crate::input::mouse::sleep_bounded(
+            deadline,
+            std::time::Duration::from_millis(10),
+            delivery,
+        )
+        .map_err(after_effect)?;
+    }
+    match event.kind {
+        MouseEventKind::Move => {
+            crate::input::mouse::ensure_budget(deadline, delivery).map_err(after_effect)
+        }
+        MouseEventKind::Down | MouseEventKind::Up => unreachable!(),
+        MouseEventKind::Click { count } => {
+            for index in 1..=count {
+                let down = crate::input::mouse::create_event_with_source(
+                    &source,
+                    down_type(&event.button),
+                    point,
+                    button,
+                    flags,
+                )
+                .map_err(after_effect)?;
+                let up = crate::input::mouse::create_event_with_source(
+                    &source,
+                    up_type(&event.button),
+                    point,
+                    button,
+                    flags,
+                )
+                .map_err(after_effect)?;
+                down.set_integer_value_field(EventField::MOUSE_EVENT_CLICK_STATE, index as i64);
+                up.set_integer_value_field(EventField::MOUSE_EVENT_CLICK_STATE, index as i64);
+                let own_state =
+                    i32::try_from(down.get_integer_value_field(EventField::EVENT_SOURCE_STATE_ID))
+                        .ok()
+                        .filter(|id| !matches!(*id, -1..=1));
+                let permit = receiver
+                    .qualify(&event.point, deadline, PointerState::FreeAtPoint)
+                    .map_err(after_effect)?;
+                down.post(CGEventTapLocation::HID);
+                let mut release = Release {
+                    event: Some(up),
+                    receiver: &receiver,
+                    point: &event.point,
+                    permit,
+                    button: button as u32,
+                    own_state,
+                    observed_down: own_state.is_some_and(|state| button_down(state, button as u32))
+                        && !button_down(1, button as u32),
+                };
+                crate::input::mouse::sleep_bounded(
+                    deadline,
+                    std::time::Duration::from_millis(10),
+                    delivery,
+                )
+                .map_err(after_effect)?;
+                if !release.finish() {
+                    return Err(after_effect(AdapterError::stale_ref_because(
+                        "Pointer release receiver changed",
+                    )));
+                }
+                crate::input::mouse::ensure_budget(deadline, delivery).map_err(after_effect)?;
+                if index < count {
+                    crate::input::mouse::sleep_bounded(
+                        deadline,
+                        std::time::Duration::from_millis(30),
+                        delivery,
+                    )
+                    .map_err(after_effect)?;
+                }
+            }
+            Ok(())
+        }
+        MouseEventKind::Wheel { .. } => {
+            for (dy, dx) in scroll_chunks.expect("wheel chunks were validated before delivery") {
+                let scroll =
+                    CGEvent::new_scroll_event(source.clone(), ScrollEventUnit::LINE, 2, dy, dx, 0)
+                        .map_err(|()| {
+                            after_effect(AdapterError::internal("Scroll event unavailable"))
+                        })?;
+                scroll.set_location(point);
+                scroll.set_flags(flags);
+                let _authority = receiver
+                    .qualify(&event.point, deadline, PointerState::FreeAtPoint)
+                    .map_err(after_effect)?;
+                scroll.post(CGEventTapLocation::HID);
+                crate::input::mouse::ensure_budget(deadline, delivery).map_err(after_effect)?;
+            }
+            Ok(())
+        }
+    }
+}
+
+pub(crate) fn drag(
+    target: Target<'_>,
+    destination: Destination<'_>,
+    id: &str,
+    mut params: agent_desktop_core::DragParams,
+    deadline: Deadline,
+) -> Result<(), AdapterError> {
+    use core_graphics::event::CGMouseButton;
+    let duration = params.duration_ms.unwrap_or(300);
+    let drop_delay = params.drop_delay_ms.unwrap_or(500);
+    params.duration_ms = Some(duration);
+    params.drop_delay_ms = Some(drop_delay);
+    params.validate(deadline)?;
+    let required = duration
+        .checked_add(drop_delay)
+        .and_then(|v| v.checked_add(210))
+        .ok_or_else(|| {
+            AdapterError::new(
+                agent_desktop_core::ErrorCode::InvalidArgs,
+                "Drag timing is invalid",
+            )
+        })?;
+    if deadline.remaining() < std::time::Duration::from_millis(required) {
+        return Err(deadline
+            .timeout_error()
+            .with_disposition(agent_desktop_core::DeliverySemantics::not_delivered()));
+    }
+    let source = core_graphics::event_source::CGEventSource::new(
+        core_graphics::event_source::CGEventSourceStateID::Private,
+    )
+    .map_err(|()| AdapterError::internal("Private pointer event source is unavailable"))?;
+    let flags = crate::input::mouse::event_flags(&params.modifiers);
+    let origin = CGPoint::new(params.from.x, params.from.y);
+    let down = crate::input::mouse::create_event_with_source(
+        &source,
+        CGEventType::LeftMouseDown,
+        origin,
+        CGMouseButton::Left,
+        flags,
+    )?;
+    let first_up = crate::input::mouse::create_event_with_source(
+        &source,
+        CGEventType::LeftMouseUp,
+        origin,
+        CGMouseButton::Left,
+        flags,
+    )?;
+    let state = i32::try_from(down.get_integer_value_field(EventField::EVENT_SOURCE_STATE_ID))
+        .ok()
+        .filter(|id| !matches!(*id, -1..=1))
+        .ok_or_else(|| AdapterError::not_supported("private drag event state"))?;
+    if button_down(state, 0) || button_down(1, 0) {
+        return Err(AdapterError::stale_ref_because(
+            "Drag button is already held",
+        ));
+    }
+    let receiver = Receiver::new(target, id, deadline)?;
+    let steps_receiver = Receiver::new(target.window_scope(), id, deadline)?;
+    let destination_receiver = match destination {
+        Destination::Window => Receiver::new(target.window_scope(), id, deadline)?,
+        Destination::Element(element) => Receiver::new(
+            Target::Element {
+                window: target.window(),
+                element,
+            },
+            id,
+            deadline,
+        )?,
+    };
+    send(
+        target,
+        id,
+        MouseEvent {
+            kind: MouseEventKind::Move,
+            point: params.from.clone(),
+            button: agent_desktop_core::MouseButton::Left,
+            modifiers: params.modifiers,
+        },
+        deadline,
+    )?;
+    let uncertain = crate::actions::DeliveryTracker::uncertain;
+    let delivered = crate::actions::DeliveryTracker::from_delivered_units(1);
+    crate::input::mouse::sleep_bounded(deadline, std::time::Duration::from_millis(10), delivered)
+        .map_err(uncertain)?;
+    let down_permit = receiver
+        .qualify(&params.from, deadline, PointerState::FreeAtPoint)
+        .map_err(uncertain)?;
+    let mut release = DragRelease {
+        receiver: &steps_receiver,
+        down: down_permit,
+        current: params.from.clone(),
+        current_permit: None,
+        up: Some(first_up),
+        state,
+        observed_down: false,
+        armed: false,
+    };
+    release.armed = true;
+    down.post(CGEventTapLocation::HID);
+    crate::input::mouse::sleep_bounded(deadline, std::time::Duration::from_millis(200), delivered)
+        .map_err(uncertain)?;
+    release.observed_down = button_down(state, 0) && !button_down(1, 0);
+    if !release.observed_down {
+        return Err(uncertain(AdapterError::stale_ref_because(
+            "Owned drag button state is unavailable",
+        )));
+    }
+    let motion = agent_desktop_core::CursorMotion::new(params.from.clone(), params.to.clone());
+    let steps = duration
+        .div_ceil(16)
+        .clamp(1, agent_desktop_core::MAX_DRAG_STEPS);
+    for index in 1..=steps {
+        let next = motion.sample(motion.duration_ms() * index / steps);
+        let cg = CGPoint::new(next.x, next.y);
+        let step = crate::input::mouse::create_event_with_source(
+            &source,
+            CGEventType::LeftMouseDragged,
+            cg,
+            CGMouseButton::Left,
+            flags,
+        )
+        .map_err(uncertain)?;
+        let up = crate::input::mouse::create_event_with_source(
+            &source,
+            CGEventType::LeftMouseUp,
+            cg,
+            CGMouseButton::Left,
+            flags,
+        )
+        .map_err(uncertain)?;
+        let receiver = if index == steps {
+            &destination_receiver
+        } else {
+            &steps_receiver
+        };
+        let permit = receiver
+            .qualify(
+                &next,
+                deadline,
+                PointerState::Held {
+                    down: &release.down,
+                    button: 0,
+                    source: state,
+                    cursor: &release.current,
+                },
+            )
+            .map_err(uncertain)?;
+        step.post(CGEventTapLocation::HID);
+        release.current = next;
+        release.current_permit = Some(permit);
+        release.up = Some(up);
+        let pause = std::time::Duration::from_secs_f64(duration as f64 / steps as f64 / 1000.0);
+        crate::input::mouse::sleep_bounded(deadline, pause, delivered).map_err(uncertain)?;
+    }
+    crate::input::mouse::sleep_bounded(
+        deadline,
+        std::time::Duration::from_millis(drop_delay),
+        delivered,
+    )
+    .map_err(uncertain)?;
+    let final_permit = destination_receiver
+        .qualify(
+            &release.current,
+            deadline,
+            PointerState::Held {
+                down: &release.down,
+                button: 0,
+                source: state,
+                cursor: &release.current,
+            },
+        )
+        .map_err(uncertain)?;
+    release.current_permit = Some(final_permit);
+    if !release.finish() {
+        return Err(uncertain(AdapterError::stale_ref_because(
+            "Drag release receiver changed",
+        )));
+    }
+    crate::input::mouse::ensure_budget(deadline, delivered).map_err(uncertain)
+}
+
+struct DragRelease<'a, 'b> {
+    receiver: &'a Receiver<'b>,
+    down: Permit,
+    current: Point,
+    current_permit: Option<Permit>,
+    up: Option<CGEvent>,
+    state: i32,
+    observed_down: bool,
+    armed: bool,
+}
+
+impl DragRelease<'_, '_> {
+    fn finish(&mut self) -> bool {
+        let Some(up) = self.up.take() else {
+            return true;
+        };
+        if !self.armed {
+            return true;
+        }
+        let instant = std::time::Instant::now() + std::time::Duration::from_secs(1);
+        let current = self.current_permit.as_ref().unwrap_or(&self.down);
+        if self
+            .down
+            .window
+            .revalidate(self.receiver.target.window(), instant)
+            .is_err()
+            || self
+                .down
+                .hit
+                .revalidate(&self.down.element, instant)
+                .is_err()
+            || current.hit.revalidate(&current.element, instant).is_err()
+            || button_down(1, 0)
+            || (1..32).any(|button| button_down(0, button))
+        {
+            return false;
+        }
+        if let Original::Element { element, authority } = &self.down.original {
+            if authority.revalidate(element, instant).is_err() {
+                return false;
+            }
+        }
+        if let Original::Element { element, authority } = &current.original {
+            if authority.revalidate(element, instant).is_err() {
+                return false;
+            }
+        }
+        let system =
+            AXElement::from_raw(unsafe { accessibility_sys::AXUIElementCreateSystemWide() });
+        if crate::tree::properties::ax_ipc::prepare(&system, instant).is_err() {
+            return false;
+        }
+        let mut hit = std::ptr::null_mut();
+        let error = unsafe {
+            accessibility_sys::AXUIElementCopyElementAtPosition(
+                system.raw(),
+                self.current.x as f32,
+                self.current.y as f32,
+                &mut hit,
+            )
+        };
+        if error != accessibility_sys::kAXErrorSuccess || hit.is_null() {
+            if !hit.is_null() {
+                unsafe { core_foundation::base::CFRelease(hit.cast()) };
+            }
+            return false;
+        }
+        let hit = AXElement::from_raw(hit);
+        if self.receiver.revalidate_cleanup_owner(instant).is_err() {
+            return false;
+        }
+        let cursor = crate::input::mouse::event_source()
+            .ok()
+            .and_then(|source| CGEvent::new(source).ok())
+            .map(|event| event.location());
+        if let Original::Element { element, authority } = &self.down.original {
+            if authority.revalidate(element, instant).is_err() {
+                return false;
+            }
+        }
+        if let Original::Element { element, authority } = &current.original {
+            if authority.revalidate(element, instant).is_err() {
+                return false;
+            }
+        }
+        if !crate::tree::same_element(&hit, &current.element)
+            || cursor.is_none_or(|point| {
+                (point.x - self.current.x).abs() > 0.5 || (point.y - self.current.y).abs() > 0.5
+            })
+            || self
+                .down
+                .window
+                .revalidate(self.receiver.target.window(), instant)
+                .is_err()
+            || self
+                .down
+                .hit
+                .revalidate(&self.down.element, instant)
+                .is_err()
+            || !self.receiver.native_window_at(&self.current)
+            || button_down(1, 0)
+            || (1..32).any(|button| button_down(0, button))
+        {
+            return false;
+        }
+        if self.receiver.revalidate_cleanup_owner(instant).is_err() {
+            return false;
+        }
+        let latest = CGEvent::new(self.receiver.pointer_source.clone())
+            .ok()
+            .map(|event| event.location());
+        if latest.is_none_or(|p| {
+            (p.x - self.current.x).abs() > 0.5 || (p.y - self.current.y).abs() > 0.5
+        }) || !self.receiver.native_window_at(&self.current)
+            || button_down(1, 0)
+            || (1..32).any(|button| button_down(0, button))
+        {
+            return false;
+        }
+        let owned_down = self.observed_down || (button_down(self.state, 0) && !button_down(1, 0));
+        up.post(CGEventTapLocation::HID);
+        if owned_down && !button_down(self.state, 0) && !button_down(1, 0) {
+            agent_desktop_core::commands::clovy_cancel::acknowledge_release(true);
+        }
+        true
+    }
+}
+impl Drop for DragRelease<'_, '_> {
+    fn drop(&mut self) {
+        self.finish();
+    }
+}
+
+struct Release<'a, 'b> {
+    event: Option<CGEvent>,
+    receiver: &'a Receiver<'b>,
+    point: &'a Point,
+    permit: Permit,
+    button: u32,
+    own_state: Option<i32>,
+    observed_down: bool,
+}
+impl Release<'_, '_> {
+    fn finish(&mut self) -> bool {
+        let Some(event) = self.event.take() else {
+            return true;
+        };
+        let instant = std::time::Instant::now() + std::time::Duration::from_secs(1);
+        if self
+            .permit
+            .window
+            .revalidate(self.receiver.target.window(), instant)
+            .is_err()
+            || self
+                .permit
+                .hit
+                .revalidate(&self.permit.element, instant)
+                .is_err()
+        {
+            return false;
+        }
+        if let Original::Element { element, authority } = &self.permit.original {
+            if authority.revalidate(element, instant).is_err() {
+                return false;
+            }
+        }
+        let system =
+            AXElement::from_raw(unsafe { accessibility_sys::AXUIElementCreateSystemWide() });
+        if crate::tree::properties::ax_ipc::prepare(&system, instant).is_err() {
+            return false;
+        }
+        let mut hit = std::ptr::null_mut();
+        let error = unsafe {
+            accessibility_sys::AXUIElementCopyElementAtPosition(
+                system.raw(),
+                self.point.x as f32,
+                self.point.y as f32,
+                &mut hit,
+            )
+        };
+        if error != accessibility_sys::kAXErrorSuccess || hit.is_null() {
+            if !hit.is_null() {
+                unsafe { core_foundation::base::CFRelease(hit.cast()) };
+            }
+            return false;
+        }
+        let hit = AXElement::from_raw(hit);
+        if self.receiver.revalidate_geometry(instant).is_err() {
+            return false;
+        }
+        let position = crate::input::mouse::event_source()
+            .ok()
+            .and_then(|source| CGEvent::new(source).ok())
+            .map(|event| event.location());
+        if let Original::Element { element, authority } = &self.permit.original {
+            if authority.revalidate(element, instant).is_err() {
+                return false;
+            }
+        }
+        if !crate::tree::same_element(&hit, &self.permit.element)
+            || position.is_none_or(|p| {
+                (p.x - self.point.x).abs() > 0.5 || (p.y - self.point.y).abs() > 0.5
+            })
+            || self
+                .permit
+                .window
+                .revalidate(self.receiver.target.window(), instant)
+                .is_err()
+            || self
+                .permit
+                .hit
+                .revalidate(&self.permit.element, instant)
+                .is_err()
+            || !self.receiver.native_window_at(self.point)
+            || button_down(1, self.button)
+            || (0..32).any(|other| other != self.button && button_down(0, other))
+        {
+            return false;
+        }
+        if self.receiver.revalidate_geometry(instant).is_err() {
+            return false;
+        }
+        let latest = CGEvent::new(self.receiver.pointer_source.clone())
+            .ok()
+            .map(|event| event.location());
+        if latest
+            .is_none_or(|p| (p.x - self.point.x).abs() > 0.5 || (p.y - self.point.y).abs() > 0.5)
+            || !self.receiver.native_window_at(self.point)
+            || button_down(1, self.button)
+            || (0..32).any(|other| other != self.button && button_down(0, other))
+        {
+            return false;
+        }
+        event.post(CGEventTapLocation::HID);
+        if self.observed_down
+            && self
+                .own_state
+                .is_some_and(|state| !button_down(state, self.button))
+            && !button_down(1, self.button)
+        {
+            agent_desktop_core::commands::clovy_cancel::acknowledge_release(true);
+        }
+        true
+    }
+}
+
+fn button_down(state: i32, button: u32) -> bool {
+    unsafe extern "C" {
+        fn CGEventSourceButtonState(state: i32, button: u32) -> bool;
+    }
+    unsafe { CGEventSourceButtonState(state, button) }
+}
+impl Drop for Release<'_, '_> {
+    fn drop(&mut self) {
+        self.finish();
+    }
+}
