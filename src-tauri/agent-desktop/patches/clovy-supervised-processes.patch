+            }
+            OwnerGeneration::LiveProcess => {
+                crate::system::process::process_identity::matches_instance(pid, &instance)?
+            }
+        };
+        if !matches {
+            return Err(owner_churn_error(Some(pid), "process_generation_changed"));
+        }
+        expected.insert(pid, instance);
+    }
