+        },
+        &effects,
+    )
+    .unwrap_err();
+    let AppError::Adapter(error) = error else {
+        panic!("expected adapter failure")
+    };
+    assert_eq!(error.disposition.retry(), crate::RetryDisposition::Unsafe);
+    assert_eq!(delivered.focus_calls.load(Ordering::SeqCst), 1);
