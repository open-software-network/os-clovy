+use super::*;
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicBool, AtomicUsize, Ordering},
+};
+#[derive(Clone, Copy)]
+enum Change {
+    Stable,
+    ReusedAtLease,
+    ReusedBeforeResolve,
+    SecureBeforeFocus,
+    SecureAfterFocus,
+    ResolveAfterFocus,
+    GeometryAfterFocus,
+    CancelAfterFocus,
+    InputRefused,
+}
+struct World {
+    window: Mutex<WindowInfo>,
+    change: Change,
+    leased: Arc<AtomicBool>,
+    focuses: AtomicUsize,
+    inputs: AtomicUsize,
+    native_input_calls: AtomicUsize,
+}
+impl World {
+    fn new(change: Change) -> Self {
+        let mut initial = window();
+        if matches!(change, Change::ReusedBeforeResolve) {
+            initial.pid = crate::ProcessId::new(99);
+            initial.process_instance = Some("B:2".into());
+        }
+        Self {
+            window: Mutex::new(initial),
+            change,
+            leased: Arc::new(AtomicBool::new(false)),
+            focuses: AtomicUsize::new(0),
+            inputs: AtomicUsize::new(0),
+            native_input_calls: AtomicUsize::new(0),
+        }
+    }
+    fn in_lease(&self) {
+        assert!(
+            self.leased.load(Ordering::SeqCst),
+            "consumer accessed native authority outside lease"
+        );
+    }
+}
+struct Lease(Arc<AtomicBool>);
+impl Drop for Lease {
+    fn drop(&mut self) {
+        self.0.store(false, Ordering::SeqCst);
+    }
+}
+fn window() -> WindowInfo {
+    serde_json::from_value(json!({"id":"w-7","pid":42,"process_instance":"A:1","title":"Synthetic","app_name":"Fixture","bounds":{"x":0.0,"y":0.0,"width":100.0,"height":100.0},"is_focused":true,"visible":true})).unwrap()
+}
+impl crate::adapter::ActionOps for World {}
+impl crate::adapter::ObservationOps for World {
+    fn list_windows(
+        &self,
+        _filter: &crate::WindowFilter,
+        _deadline: Deadline,
+    ) -> Result<Vec<WindowInfo>, AdapterError> {
+        Ok(vec![self.window.lock().unwrap().clone()])
+    }
+    fn list_apps(&self, _deadline: Deadline) -> Result<Vec<crate::AppInfo>, AdapterError> {
+        let w = self.window.lock().unwrap();
+        Ok(vec![crate::AppInfo {
+            name: w.app.clone(),
+            pid: w.pid,
+            bundle_id: None,
+            process_instance: w.process_instance.clone(),
+            presentation: None,
+        }])
+    }
+    fn get_tree(
+        &self,
+        _window: &WindowInfo,
+        _options: &crate::TreeOptions,
+        _deadline: Deadline,
+    ) -> Result<crate::AccessibilityNode, AdapterError> {
+        self.in_lease();
+        let mut tree = crate::adapter::minimal_accessibility_node("window", "Synthetic");
+        if matches!(self.change, Change::SecureBeforeFocus)
+            || matches!(self.change, Change::SecureAfterFocus)
+                && self.focuses.load(Ordering::SeqCst) > 0
+        {
+            let mut child = crate::adapter::minimal_accessibility_node("textfield", "Password");
+            child.presentation.states = vec!["secure".into(), "focused".into()];
+            child.presentation.bounds = self.window.lock().unwrap().bounds;
+            tree.children.push(child);
+        }
+        Ok(tree)
+    }
+}
+impl crate::adapter::SystemOps for World {
+    fn press_key_for_app(
+        &self,
+        _process: crate::ProcessIdentity,
+        _combo: &crate::KeyCombo,
+        _policy: crate::InteractionPolicy,
+        _lease: &InteractionLease,
+    ) -> Result<crate::ActionResult, AdapterError> {
+        self.in_lease();
+        self.inputs.fetch_add(1, Ordering::SeqCst);
+        Ok(crate::ActionResult::delivered_unverified("press_key"))
+    }
+    fn acquire_interaction_lease(
+        &self,
+        deadline: Deadline,
+    ) -> Result<InteractionLease, AdapterError> {
+        assert!(!self.leased.swap(true, Ordering::SeqCst));
+        if matches!(self.change, Change::ReusedAtLease) {
+            let mut w = self.window.lock().unwrap();
+            w.pid = crate::ProcessId::new(99);
+            w.process_instance = Some("B:2".into());
+        }
+        InteractionLease::guarded(deadline, Lease(self.leased.clone()))
+    }
+    fn resolve_window_strict(
+        &self,
+        _expected: &WindowInfo,
+        _deadline: Deadline,
+    ) -> Result<WindowInfo, AdapterError> {
+        self.in_lease();
+        if matches!(self.change, Change::ResolveAfterFocus)
+            && self.focuses.load(Ordering::SeqCst) > 0
+        {
+            return Err(
+                AdapterError::stale_ref_because("Native resolve failed after focus")
+                    .with_details(json!({"clovy_code":"fixture_resolve_lost"})),
+            );
+        }
+        Ok(self.window.lock().unwrap().clone())
+    }
+    fn focus_window(
+        &self,
+        _expected: &WindowInfo,
+        _lease: &InteractionLease,
+    ) -> Result<(), AdapterError> {
+        self.in_lease();
+        self.focuses.fetch_add(1, Ordering::SeqCst);
+        self.window.lock().unwrap().state.is_focused = true;
+        if matches!(self.change, Change::GeometryAfterFocus) {
+            self.window.lock().unwrap().bounds.as_mut().unwrap().x = 5.0;
+        }
+        if matches!(self.change, Change::CancelAfterFocus) {
+            std::fs::write(
+                std::env::var_os("CLOVY_AGENT_DESKTOP_CANCEL_FILE").unwrap(),
+                b"stop",
+            )
+            .unwrap();
+        }
+        Ok(())
+    }
+    fn press_key_for_window(
+        &self,
+        _expected: &WindowInfo,
+        _combo: &crate::KeyCombo,
+        _policy: crate::InteractionPolicy,
+        _lease: &InteractionLease,
+    ) -> Result<crate::ActionResult, AdapterError> {
+        self.in_lease();
+        self.inputs.fetch_add(1, Ordering::SeqCst);
+        Ok(crate::ActionResult::delivered_unverified("press_key"))
+    }
+}
+impl crate::adapter::InputOps for World {
+    fn mouse_event_for_window(
+        &self,
+        _window: &WindowInfo,
+        _event: MouseEvent,
+        _lease: &InteractionLease,
+    ) -> Result<crate::OperationReport, AdapterError> {
+        self.in_lease();
+        self.native_input_calls.fetch_add(1, Ordering::SeqCst);
+        if matches!(self.change, Change::InputRefused) {
+            return Err(AdapterError::new(
+                ErrorCode::ActionNotSupported,
+                "Native input refused before Send",
+            )
+            .with_details(json!({"native_reason":"preflight_not_attempted"}))
+            .with_disposition(DeliverySemantics::not_delivered()));
+        }
+        self.inputs.fetch_add(1, Ordering::SeqCst);
+        Ok(crate::adapter::test_report())
+    }
+    fn drag_for_window(
+        &self,
+        _window: &WindowInfo,
+        _params: DragParams,
+        _lease: &InteractionLease,
+    ) -> Result<crate::OperationReport, AdapterError> {
+        self.in_lease();
+        self.native_input_calls.fetch_add(1, Ordering::SeqCst);
+        if matches!(self.change, Change::InputRefused) {
+            return Err(AdapterError::new(
+                ErrorCode::ActionNotSupported,
+                "Native input refused before Send",
+            )
+            .with_details(json!({"native_reason":"preflight_not_attempted"}))
+            .with_disposition(DeliverySemantics::not_delivered()));
+        }
+        self.inputs.fetch_add(1, Ordering::SeqCst);
+        Ok(crate::adapter::test_report())
+    }
+}
+#[test]
+fn window_key_consumer_rejects_reused_handle_inside_lease_before_any_effect() {
+    for (headed, change) in [false, true].into_iter().flat_map(|headed| {
+        [Change::ReusedBeforeResolve, Change::ReusedAtLease]
+            .into_iter()
+            .map(move |change| (headed, change))
+    }) {
+        let world = World::new(change);
+        let context = CommandContext::default().with_headed(headed);
+        let result = press_window(
+            &serde_json::to_string(&window()).unwrap(),
+            "escape".into(),
+            &world,
+            &context,
+        );
+        assert_eq!(world.focuses.load(Ordering::SeqCst), 0);
+        assert_eq!(world.inputs.load(Ordering::SeqCst), 0);
+        assert!(!world.leased.load(Ordering::SeqCst));
+        let error = result.unwrap_err();
+        assert_eq!(error.code(), "STALE_REF");
+        match error {
+            AppError::Adapter(error) => {
+                assert_eq!(error.disposition, DeliverySemantics::not_delivered())
+            }
+            other => panic!("{other}"),
+        }
+    }
+}
+#[test]
+fn window_key_consumer_preserves_stable_authority_in_both_modalities() {
+    for headed in [false, true] {
+        let world = World::new(Change::Stable);
+        let context = CommandContext::default().with_headed(headed);
+        let result = press_window(
+            &serde_json::to_string(&window()).unwrap(),
+            "ctrl+f".into(),
+            &world,
+            &context,
+        )
+        .unwrap();
+        assert_eq!(world.focuses.load(Ordering::SeqCst), usize::from(headed));
+        assert_eq!(world.inputs.load(Ordering::SeqCst), 1);
+        assert_eq!(result["disposition"]["retry"], "unsafe");
+        assert!(!world.leased.load(Ordering::SeqCst));
+    }
+}
+fn gesture(world: &World, dragging: bool) -> Result<Value, AppError> {
+    let encoded = serde_json::to_string(&window()).unwrap();
+    let context = CommandContext::default().with_headed(true);
+    if dragging {
+        drag(
+            &encoded,
+            vec![],
+            (10.0, 10.0),
+            (20.0, 20.0),
+            world,
+            &context,
+        )
+    } else {
+        mouse(
+            &encoded,
+            MouseEvent {
+                point: Point { x: 10.0, y: 10.0 },
+                button: crate::MouseButton::Left,
+                kind: MouseEventKind::Click { count: 1 },
+                modifiers: vec![],
+            },
+            world,
+            &context,
+        )
+    }
+}
+
+fn assert_after_focus(change: Change, dragging: bool) {
+    let world = World::new(change);
+    let error = gesture(&world, dragging).unwrap_err();
+    assert_eq!(world.focuses.load(Ordering::SeqCst), 1);
+    assert_eq!(world.inputs.load(Ordering::SeqCst), 0);
+    match error {
+        AppError::Adapter(error) => {
+            assert_eq!(error.disposition.retry(), crate::RetryDisposition::Unsafe);
+            let details = error.details.unwrap();
+            assert_eq!(
+                details["native_disposition"],
+                json!(DeliverySemantics::not_delivered())
+            );
+            let focus = &details["preparatory_effects"]["focus"];
+            assert_eq!(focus["attempted"], true);
+            assert_eq!(focus["confirmed"], true);
+            assert_eq!(focus["pid"], 42);
+            assert_eq!(
+                details["preparatory_effects"]["target_input"]["attempted"],
+                false
+            );
+            if matches!(change, Change::ResolveAfterFocus) {
+                assert_eq!(details["clovy_code"], "fixture_resolve_lost");
+            }
+        }
+        other => panic!("{other}"),
+    }
+}
+#[test]
+fn guard_or_resolve_failure_after_focus_keeps_partial_delivery_and_never_sends_mouse_or_drag() {
+    for dragging in [false, true] {
+        for change in [Change::SecureAfterFocus, Change::ResolveAfterFocus] {
+            assert_after_focus(change, dragging);
+        }
+    }
+}
+
+#[test]
+fn moved_window_keeps_old_point_inside_but_refuses_click_and_drag() {
+    for dragging in [false, true] {
+        assert_after_focus(Change::GeometryAfterFocus, dragging);
+    }
+}
+#[test]
+fn refusal_before_focus_stays_not_delivered_and_safe() {
+    for dragging in [false, true] {
+        let world = World::new(Change::SecureBeforeFocus);
+        let error = gesture(&world, dragging).unwrap_err();
+        assert_eq!(world.focuses.load(Ordering::SeqCst), 0);
+        assert_eq!(world.inputs.load(Ordering::SeqCst), 0);
+        match error {
+            AppError::Adapter(error) => {
+                assert_eq!(error.disposition, DeliverySemantics::not_delivered())
+            }
+            other => panic!("{other}"),
+        }
+    }
+}
+#[test]
+fn cancellation_after_focus_preserves_partial_delivery_in_isolated_consumer_process() {
+    for dragging in [false, true] {
+        let root = std::env::var_os("CLOVY_A2_PROOF_ROOT")
+            .map(std::path::PathBuf::from)
+            .unwrap_or_else(std::env::temp_dir)
+            .join(format!(
+                "clovy-a2-{}-{}",
+                std::process::id(),
+                std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)
+                    .unwrap()
+                    .as_nanos()
+            ));
+        std::fs::create_dir_all(&root).unwrap();
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--ignored",
+                "--exact",
+                "commands::clovy_targeted::review_tests::cancellation_after_focus_child",
+                "--nocapture",
+            ])
+            .env("CLOVY_AGENT_DESKTOP_SUPERVISED", "1")
+            .env("CLOVY_AGENT_DESKTOP_CANCEL_FILE", root.join("cancel"))
+            .env(
+                "CLOVY_AGENT_DESKTOP_CANCEL_ACK_FILE",
+                root.join("cancel-ack"),
+            )
+            .env("CLOVY_A2_DRAG", if dragging { "1" } else { "0" })
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}\n{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+    }
+}
+#[test]
+#[ignore = "only the isolated consumer parent sets the private cancellation namespace"]
+fn cancellation_after_focus_child() {
+    assert_eq!(
+        std::env::var("CLOVY_AGENT_DESKTOP_SUPERVISED").unwrap(),
+        "1"
+    );
+    assert_after_focus(
+        Change::CancelAfterFocus,
+        std::env::var("CLOVY_A2_DRAG").unwrap() == "1",
+    );
+}
+
+#[test]
+fn native_input_refusal_after_focus_retains_original_disposition_without_replay() {
+    for dragging in [false, true] {
+        let world = World::new(Change::InputRefused);
+        let error = gesture(&world, dragging).unwrap_err();
+        assert_eq!(world.focuses.load(Ordering::SeqCst), 1);
+        assert_eq!(world.native_input_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(world.inputs.load(Ordering::SeqCst), 0);
+        match error {
+            AppError::Adapter(error) => {
+                assert_eq!(error.code, ErrorCode::ActionNotSupported);
+                assert_eq!(error.disposition, DeliverySemantics::delivered_unverified());
+                let details = error.details.unwrap();
+                assert_eq!(
+                    details["native_disposition"],
+                    json!(DeliverySemantics::not_delivered())
+                );
+                assert_eq!(details["native_reason"], "preflight_not_attempted");
+                assert_eq!(details["preparatory_effects"]["focus"]["confirmed"], true);
+                assert_eq!(
+                    details["preparatory_effects"]["target_input"]["attempted"],
+                    true
+                );
+            }
+            other => panic!("{other}"),
+        }
+    }
+}
