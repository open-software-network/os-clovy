+    let adapter = MinimizedWindowAdapter::new(false);
+    adapter.safe_refusals.store(1, Ordering::SeqCst);
+    let deadline = crate::Deadline::after(5_000).unwrap();
+    let context = crate::CommandContext::default().with_headed(true);
+    let effects = super::PointEffects::default();
+    let error = before_first_event(
+        || {
+            let lease = adapter.acquire_interaction_lease(deadline)?;
+            focus_point_under_lease(args, &lease, &adapter, &context, &effects)
+        },
+        &effects,
+    )
+    .unwrap_err();
+    let AppError::Adapter(error) = error else {
+        panic!("expected adapter failure")
+    };
+    assert_eq!(error.disposition.retry(), crate::RetryDisposition::Safe);
+    adapter.safe_refusals.store(1, Ordering::SeqCst);
+    let result = before_first_event(
+        || {
+            retry_leased_point_phase(
+                Some(5_000),
+                deadline,
+                || {
+                    let lease = adapter.acquire_interaction_lease(deadline)?;
+                    focus_point_under_lease(args, &lease, &adapter, &context, &effects)
+                },
+                &effects,
+            )
+        },
+        &effects,
+    )
+    .unwrap();
+    assert!(result);
+    assert_eq!(adapter.focus_calls.load(Ordering::SeqCst), 3);
+
+    let delivered = MinimizedWindowAdapter::new(true);
+    let effects = super::PointEffects::default();
+    let error = before_first_event(
