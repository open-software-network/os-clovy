+    let app_attribute = CFString::new("AXFocusedApplication");
+    if require_foreground {
+        crate::tree::properties::ax_ipc::prepare(&system, instant)?;
+    }
+    let authority = expected.effect_authority(instant)?;
+    agent_desktop_core::commands::clovy_cancel::ensure()?;
+    authority.revalidate(expected, instant)?;
+    let mut value = std::ptr::null();
+    let error = unsafe {
+        accessibility_sys::AXUIElementCopyAttributeValue(
+            app.raw(),
+            attribute.as_concrete_TypeRef(),
+            &mut value,
+        )
+    };
+    if error != accessibility_sys::kAXErrorSuccess {
+        if !value.is_null() {
+            unsafe { core_foundation::base::CFRelease(value) };
+        }
+        return Err(AdapterError::stale_ref_because(
+            "Keyboard focus could not be revalidated",
+        ));
+    }
+    let current = crate::tree::properties::ax_value::created_ax_element(value)
+        .ok_or_else(|| AdapterError::stale_ref_because("Keyboard focus is unavailable"))?;
+    if !crate::tree::same_element(expected, &current) {
+        return Err(AdapterError::stale_ref_because("Keyboard focus changed"));
+    }
+    authority.revalidate(expected, instant)?;
+    if require_foreground {
+        let mut value = std::ptr::null();
+        let error = unsafe {
+            accessibility_sys::AXUIElementCopyAttributeValue(
+                system.raw(),
+                app_attribute.as_concrete_TypeRef(),
+                &mut value,
+            )
+        };
+        if error != accessibility_sys::kAXErrorSuccess {
+            if !value.is_null() {
+                unsafe { core_foundation::base::CFRelease(value) };
+            }
+            return Err(AdapterError::stale_ref_because(
+                "Foreground application could not be revalidated",
+            ));
+        }
+        let current =
+            crate::tree::properties::ax_value::created_ax_element(value).ok_or_else(|| {
+                AdapterError::stale_ref_because("Foreground application is unavailable")
+            })?;
+        if !crate::tree::same_element(&app, &current) {
+            return Err(AdapterError::stale_ref_because(
+                "Foreground application changed",
+            ));
+        }
+    }
+    let mut value = std::ptr::null();
+    let error = unsafe {
+        accessibility_sys::AXUIElementCopyAttributeValue(
+            app.raw(),
+            attribute.as_concrete_TypeRef(),
+            &mut value,
+        )
+    };
+    if error != accessibility_sys::kAXErrorSuccess {
+        if !value.is_null() {
+            unsafe { core_foundation::base::CFRelease(value) };
+        }
+        return Err(AdapterError::stale_ref_because(
+            "Keyboard focus could not be revalidated",
+        ));
+    }
+    let current = crate::tree::properties::ax_value::created_ax_element(value)
+        .ok_or_else(|| AdapterError::stale_ref_because("Keyboard focus is unavailable"))?;
+    if !crate::tree::same_element(expected, &current) {
+        return Err(AdapterError::stale_ref_because("Keyboard focus changed"));
+    }
+    authority.revalidate(expected, instant)?;
+    deadline.ensure_remaining()?;
+    Ok(authority)
