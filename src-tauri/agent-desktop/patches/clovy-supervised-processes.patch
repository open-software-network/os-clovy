+#[cfg(target_os = "macos")]
+pub(crate) fn perform_window_key_action(
+    element: &crate::tree::AXElement,
+    action: CFStringRef,
+    focused: &crate::tree::AXElement,
+    window: &crate::tree::AXElement,
+    require_foreground: bool,
+    deadline: Deadline,
+) -> Result<i32, AdapterError> {
+    use core_foundation::{base::TCFType, string::CFString};
+    let instant = deadline.absolute().map_err(pre_mutation_error)?;
+    let authority = element
+        .effect_authority(instant)
+        .map_err(pre_mutation_error)?;
+    let root = focused.root_identity().map_err(pre_mutation_error)?;
+    let pid =
+        crate::system::process::process_identity::to_pid_t(root.pid).map_err(pre_mutation_error)?;
+    let mut app = crate::tree::element_for_pid(pid);
+    app.bind_child(focused, instant)
+        .map_err(pre_mutation_error)?;
+    prepare(&app, deadline).map_err(pre_mutation_error)?;
+    let focus_attribute = CFString::new("AXFocusedUIElement");
+    let window_attribute = CFString::new("AXWindow");
+    let scope = crate::actions::physical_keyboard::keyboard_window_authority(
+        focused,
+        window,
+        require_foreground,
+        deadline,
+    )
+    .map_err(pre_mutation_error)?;
+    // The scoped reader can address the mutation element itself. Install the
+    // mutation timeout only after all readers have finished configuring AX.
+    let timeout = prepare_mutation(element, deadline).map_err(pre_mutation_error)?;
+    authority
+        .revalidate(element, instant)
+        .map_err(pre_mutation_error)?;
+    scope
+        .0
+        .revalidate(focused, instant)
+        .map_err(pre_mutation_error)?;
+    scope
+        .1
+        .revalidate(window, instant)
+        .map_err(pre_mutation_error)?;
+    let mut window_value = std::ptr::null();
+    let window_error = unsafe {
+        AXUIElementCopyAttributeValue(
+            focused.raw(),
+            window_attribute.as_concrete_TypeRef(),
+            &mut window_value,
+        )
+    };
+    if window_error != kAXErrorSuccess {
+        if !window_value.is_null() {
+            unsafe { core_foundation::base::CFRelease(window_value) };
+        }
+        return Err(pre_mutation_error(AdapterError::stale_ref_because(
+            "Keyboard window could not be revalidated",
+        )));
+    }
+    let current_window = crate::tree::properties::ax_value::created_ax_element(window_value)
+        .ok_or_else(|| {
+            pre_mutation_error(AdapterError::stale_ref_because(
+                "Keyboard window is unavailable",
+            ))
+        })?;
+    if !crate::tree::same_element(window, &current_window) {
+        return Err(pre_mutation_error(AdapterError::stale_ref_because(
+            "Keyboard window changed",
+        )));
+    }
+    let mut value = std::ptr::null();
+    let error = unsafe {
+        AXUIElementCopyAttributeValue(app.raw(), focus_attribute.as_concrete_TypeRef(), &mut value)
+    };
+    if error != kAXErrorSuccess {
+        if !value.is_null() {
+            unsafe { core_foundation::base::CFRelease(value) };
+        }
+        return Err(pre_mutation_error(AdapterError::stale_ref_because(
+            "Keyboard focus could not be revalidated",
+        )));
+    }
+    let current =
+        crate::tree::properties::ax_value::created_ax_element(value).ok_or_else(|| {
+            pre_mutation_error(AdapterError::stale_ref_because(
+                "Keyboard focus is unavailable",
+            ))
+        })?;
+    if !crate::tree::same_element(focused, &current) {
+        return Err(pre_mutation_error(AdapterError::stale_ref_because(
+            "Keyboard focus changed",
+        )));
+    }
+    if instant.saturating_duration_since(Instant::now()) < timeout {
+        return Err(pre_mutation_error(AdapterError::timeout(
+            "Accessibility mutation budget expired before dispatch",
+        )));
+    }
+    Ok(unsafe { AXUIElementPerformAction(element.raw(), action) })
 }

